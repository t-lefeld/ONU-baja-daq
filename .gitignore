# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# Ground station output
pc_app/logs/
*.csv
*.tlm
*.db

# Browser profile created by `run.py --web` when it launches the dashboard in
# Edge/Chrome app-mode. ~1000 files of cache and extension data, and it
# includes Chromium's "Login Data" and "Vpn Tokens" databases. App-generated
# and almost certainly empty of anything real, but a browser profile has no
# business in a git repo either way - especially a public one.
pc_app/.browser-profile/

# PyInstaller build output
pc_app/build/
pc_app/dist/

# Host test artefacts
harness
harness.exe
*.o
*.obj

# STM32CubeIDE build output
Debug/
Release/
*.elf
*.map
*.list
*.bin
*.hex
.settings/
.metadata/

# Editors / OS
.vscode/
.idea/
# VS Code multi-root workspace files. These embed absolute paths from
# whoever created them (the one in firmware/projects/ points at a
# PlatformIO esp32 folder under one specific user's Documents), so they
# are personal setup, not project configuration.
*.code-workspace
*.swp
.DS_Store
Thumbs.db
desktop.ini

# CubeIDE per-workspace settings inside vendored projects
firmware/projects/*/.settings/

# Real field-test captures ARE meant to be committed (see field_data/README.md),
# even though *.tlm/*.csv are excluded everywhere else above.
!field_data/**/*.tlm
!field_data/**/*.TLM
!field_data/**/*.csv
